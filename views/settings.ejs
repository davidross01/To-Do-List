<%- include('partials/header.ejs'); -%>
  <!-- Title -->
  <div class="box" id="heading">
    <h1>
      Settings
    </h1>
  </div>

  <!-- Lists -->
  <div class="box">
    <% users.forEach(function(user) { %>

      <div class="item">
        <!-- delete -->
        <form action="/settings/delete" method="post">
          <input id="delete<%= user.id %>" type="checkbox" onchange="this.form.submit()" name="deleteList" value="<%= user.id %>" hidden>
        </form>
        
        
        <form action="settings/edit" method="post">
          <input type="hidden" name="updatedID" value="<%= user.id %>">

          <p id="title<%= user.id %>"><b>Title:</b> <%= user.name %></p>
          <input id="editTitle<%= user.id %>" type="text" name="updateName" value="<%= user.name %>" autocomplete="off"autofocus="true" hidden="true" />

          <div id="color<%= user.id %>" class="colorbox" style="background-color: <%= user.color %>;"></div>
          <input id="editColor<%= user.id %>" type="color" name="updateColor" value="<%= user.color %>" hidden >

          <button id="edit<%= user.id %>" class="edit" onclick="editHandler(event, '<%= user.id %>')">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="16" fill="grey" class="bi bi-pencil-fill" viewBox="0 0 16 16">
              <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
            </svg>
          </button>

          <button id="done<%=user.id%>" class="edit" type="submit" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="50" fill="grey" class="bi bi-check" viewBox="0 0 16 16">
              <path d="M13.485 1.929a.75.75 0 0 1 1.06 1.06l-8 8a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 0 1 1.06-1.06L6 9.439l7.485-7.51z"/>
            </svg>
          </button>
        </form>
      </div>
      <% }); %>
        <!-- Add List -->
        <form class="item" action="/settings/add" method="post">
          <input type="text" name="newList" placeholder="New List" autocomplete="off" autofocus="true" />
          <input type="color" name="newColor" id="color" value="#83c6e3">
          <button class="add" type="submit" name="list" >+</button>
        </form>
  </div>
  <!-- #83c6e3 -->

  <script>

    function editHandler(event, id) {
      event.preventDefault();

      // Show the delete checkbox
      document.getElementById("delete" + id).removeAttribute("hidden", true);
      
      // Show the input field for editing the name
      document.getElementById("title" + id).setAttribute("hidden", true); 
      document.getElementById("editTitle" + id).removeAttribute("hidden");

      // Hide the color preview box and show the color input
      document.getElementById("color" + id).setAttribute("hidden", true); 
      document.getElementById("editColor" + id).removeAttribute("hidden");  
      

      // Hide the edit button and show the done button
      document.getElementById("edit" + id).setAttribute("hidden", true);
      document.getElementById("done" + id).removeAttribute("hidden");
    }


  </script>

  <%- include('partials/footer.ejs'); -%>